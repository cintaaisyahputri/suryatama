{
  "info": {
    "name": "Suryatama",
    "description": "routes buat project suryatama.\n\njalanin 'get session cookie' dulu sebelum request POST/PUT lain (biar csrf_token keisi otomatis). kalau abis logout atau kena 419, jalanin lagi.\n\nbase_url default 127.0.0.1:8000, ganti di variables kalau pakai xampp (biasanya localhost/suryatama/public).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "get session cookie",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            ""
          ]
        },
        "description": "run this first (or after logout) to grab a fresh XSRF cookie, saved to csrf_token via the test script"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const xsrf = pm.cookies.get('XSRF-TOKEN');",
              "if (xsrf) pm.collectionVariables.set('csrf_token', decodeURIComponent(xsrf));"
            ]
          }
        }
      ],
      "response": []
    },
